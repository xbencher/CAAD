# Copy this file to .env for local development (docker-compose reads it
# too). Never commit a real .env file.

# --- Backend (app/core/config.py) ---
ENV=dev
DATABASE_URL=postgresql+asyncpg://proxi:proxi@localhost:5442/proxi
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-please-1234567890ab

# CP-1: required secrets — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
OTP_PEPPER=change-me-otp-pepper-at-least-16-chars
PHONE_HASH_PEPPER=change-me-phone-hash-pepper-at-least-16-chars

# CP-1: optional settings (defaults shown)
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
CURRENT_TERMS_VERSION=1.0
CURRENT_PRIVACY_VERSION=1.0
SMS_PROVIDER=fake
FREE_DAILY_REQUESTS=3
MEMBER_DAILY_REQUESTS=50

LOG_LEVEL=INFO

# --- Backend test services (used by backend/tests/conftest.py) ---
TEST_DATABASE_URL=postgresql+asyncpg://proxi:proxi@localhost:5433/proxi_test
TEST_REDIS_URL=redis://localhost:6380/0

# --- Local object storage (docker-compose MinIO service) ---
# Not yet consumed by the backend app in CP-0; provisioned ahead of the
# photo-upload checkpoint so the bucket already exists in dev.
MINIO_ROOT_USER=proxi
MINIO_ROOT_PASSWORD=proxi12345
MINIO_BUCKET=proxi-dev

# --- Mobile (mobile/src/lib/env.ts, via expo-constants extra) ---
API_BASE_URL=http://localhost:8000/api/v1
